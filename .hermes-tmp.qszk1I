/* rsp_sand64.S — V-phase (fall down + sink through water) on the RSP.
 *
 * Cell encoding: uint16 plane G in RDRAM, low byte = material id, high
 * byte always 0. One RSP lane = one cell => compare masks are per-cell.
 * AIR=0 => vceq-with-vz tests empty.
 *
 * STAGE 2a: V phase ONLY (straight-down move into AIR; dense sand/seed
 * swap-sink through water). D/H/smoke/transform/fire stay on CPU.
 *
 * DMEM layout (4096 B) — one 11-row chunk per transfer:
 *   0x0000 constants: [0] x8 u16 WATER(3) [1] x8 u16 SAND(2) [2] x8 u16 SEED(4)
 *   0x0030 rows: 11 rows x 320 B, row k = grid row (ya + k), k=0..10;
 *                row 11 = halo (already-finalized row yb+1 below the chunk)
 *     (CPU loads G[ya..yb+1] contiguously: 11 rows, last = halo.)
 * Rows simulate bottom-up: k=10 down to 1 (row k=0 = top sim row? no—
 * CPU maps: sim rows ya..yb = DMEM rows 0..10-? See glue: nsim = yb-ya+1,
 * chunk rows = nsim + 1 (halo last). Row loop from k=nsim-1 downto 0;
 * below-row = k+1 (halo when k=nsim-1). 20 vectors/row (160 cells).
 *
 * Per vector (8 cells): moved = movable(cur) & (below==AIR | dense&below==W3)
 *   cur_new  = (sink & W3) | (cur & ~moved)      [AIR cells need no bits]
 *   below_new= (moved & cur) | (below & ~moved)
 * Straight-line, no branches in the inner loop, no conflicts (vertical
 * moves preserve column; each dest touched by exactly one source).
 */

#include <rsp.inc>

    .set noreorder
    .set at

    .equ C_W3,   0x0000            /* u16 x8 = 3 */
    .equ C_S2,   0x0010
    .equ C_S4,   0x0020
    .equ PARAMS, 0x0030            /* [0]=nsim [1]=ncell(160) */
    .equ ROWS,   0x0040
    .equ RSTRIDE, 320              /* 160 cells x 2 B */
    .equ NVEC,   20                /* 160 cells / 8 lanes */

    .data
    .align 8
_dummy: .word 0

    .text
    .globl _start
_start:
    /* constants -> vector regs */
    la   k0, C_W3
    lqv  v16, 0(k0)                /* WATER=3 */
    lqv  v17, 0(k0+16)             /* SAND=2  */
    lqv  v18, 0(k0+32)             /* SEED=4  */

    la   k1, PARAMS
    lw   t0, 0(k1)                 /* nsim rows */
    addi t0, t0, -1                /* row k index of bottom sim row */

rowloop:
    bltz  t0, fin
    /* p = ROWS + k*320 ; per vector i: off = p + i*16 */
    sll   t1, t0, 8
    sll   t2, t0, 6
    add   t1, t1, t2               /* k*320 */
    la    t3, ROWS
    add   t1, t1, t3               /* p */
    li    t4, NVEC-1

vecloop:
    sll   t5, t4, 4                /* i*16 */
    add   t6, t1, t5               /* &cur[i] */

    lqv  v1, 0(t6)                 /* cur        */
    lqv  v2, RSTRIDE(t6)           /* below (fin so far) */

    vceq v3, v1, v0                /* cur==AIR     */
    vceq v4, v1, v16               /* cur==WATER   */
    vceq v5, v1, v17               /* cur==SAND    */
    vceq v6, v1, v18               /* cur==SEED    */
    vor  v5, v5, v6                /* dense        */
    vor  v4, v4, v5                /* movable      */

    vceq v7, v2, v0                /* below==AIR   */
    vceq v8, v2, v16               /* below==WATER */
    vand v9, v4, v7                /* move-air     */
    vand v10, v5, v8               /* sink         */
    vor  v3, v9, v10               /* moved        */

    vand v11, v10, v16             /* sink->W3     */
    vandn v12, v3, v1              /* cur & ~moved */
    vor  v12, v11, v12
    sqv  v12, 0(t6)                /* store cur_new */

    vand v13, v3, v1               /* gained material */
    vandn v14, v3, v2
    vor  v14, v13, v14
    sqv  v14, RSTRIDE(t6)          /* store below_new (row k+1) */

    addi t4, t4, -1
    bgez t4, vecloop
    addi t0, t0, -1
    j    rowloop
fin:
    sw   zero, 0(zero)
